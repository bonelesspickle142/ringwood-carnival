{
  "name": "ProcessionBand",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Band / Group Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "link_url": {
      "type": "string",
      "title": "Website Link URL"
    },
    "afternoon_sponsor": {
      "type": "string",
      "title": "Afternoon Sponsor"
    },
    "evening_sponsor": {
      "type": "string",
      "title": "Evening Sponsor"
    },
    "sponsor": {
      "type": "string",
      "title": "Sponsor (general)",
      "description": "Use when the sponsor is not tied to a specific procession"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}