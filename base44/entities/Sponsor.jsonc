{
  "name": "Sponsor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Sponsor Name"
    },
    "image_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "url": {
      "type": "string",
      "title": "Website URL"
    },
    "is_headline": {
      "type": "boolean",
      "title": "Headline Sponsor",
      "default": false
    },
    "show_on_home": {
      "type": "boolean",
      "title": "Show on Home Carousel",
      "default": false,
      "description": "Gold+ sponsors displayed in the home page carousel (kept separate from the Sponsors page)"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0,
      "description": "Controls display order"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}