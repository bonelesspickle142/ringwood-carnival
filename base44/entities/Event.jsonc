{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Event Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "category": {
      "type": "string",
      "enum": [
        "performance",
        "food",
        "craft",
        "music",
        "family",
        "stall",
        "other"
      ],
      "title": "Category"
    },
    "carnival_period": {
      "type": "string",
      "enum": [
        "carnival_week",
        "carnival_day"
      ],
      "title": "Carnival Period"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "image_position": {
      "type": "string",
      "title": "Image Position",
      "default": "center center"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured Event"
    }
  },
  "required": [
    "title",
    "start_time",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}