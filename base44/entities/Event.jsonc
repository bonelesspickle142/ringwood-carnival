{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Event Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "category": {
      "type": "string",
      "enum": [
        "performance",
        "food",
        "craft",
        "music",
        "family",
        "stall",
        "other"
      ],
      "title": "Category"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured Event"
    }
  },
  "required": [
    "title",
    "start_time",
    "category"
  ]
}