{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Event Title"
    },
    "tagline": {
      "type": "string",
      "title": "Tagline"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "category": {
      "type": "string",
      "enum": [
        "Performance",
        "Food",
        "Craft",
        "Music",
        "Family",
        "Stall",
        "Other"
      ],
      "title": "Category"
    },
    "carnival_period": {
      "type": "string",
      "enum": [
        "carnival_week",
        "carnival_day"
      ],
      "title": "Carnival Period"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "image_position": {
      "type": "string",
      "title": "Image Position",
      "default": "center center"
    },
    "image_display_mode": {
      "type": "string",
      "enum": [
        "crop",
        "full"
      ],
      "title": "Image Display Mode",
      "default": "crop",
      "description": "Per-event image display: 'crop' uses the custom focal point, 'full' shows the entire image"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured Event"
    }
  },
  "required": [
    "title",
    "start_time",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}