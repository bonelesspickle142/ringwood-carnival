{
  "name": "MapPoint",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "enum": [
        "Event",
        "Parking",
        "Toilet",
        "First Aid",
        "Food",
        "Information",
        "Other"
      ],
      "title": "Category",
      "default": "Other"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "linked_event_id": {
      "type": "string",
      "title": "Linked Event ID"
    }
  },
  "required": [
    "name",
    "latitude",
    "longitude",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}