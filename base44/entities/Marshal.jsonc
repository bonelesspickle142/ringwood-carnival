{
  "name": "Marshal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "description": "e.g. Road Marshal, Float Marshal, First Aid"
    },
    "password": {
      "type": "string",
      "title": "Login Password"
    },
    "checked_in": {
      "type": "boolean",
      "title": "Checked In",
      "default": false
    },
    "check_in_time": {
      "type": "string",
      "title": "Check-in Time"
    },
    "notes": {
      "type": "string",
      "title": "Notes / Briefing Info"
    },
    "sector_marshal": {
      "type": "string",
      "title": "Sector Marshal (Name)"
    },
    "sector_marshal_contact": {
      "type": "string",
      "title": "Sector Marshal (Phone)"
    }
  },
  "required": [
    "name",
    "role",
    "password"
  ]
}